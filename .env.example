# ============================================================
# Qualys Container Security — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
# ============================================================

# ------ Required: choose ONE auth method ------

# Option A: Username / Password (most common)
QUALYS_USERNAME=your_qualys_username
QUALYS_PASSWORD=your_qualys_password

# Option B: OIDC Client Credentials (if OIDC is enabled on your subscription)
# Setting QUALYS_CLIENT_ID causes qualys_auth.py to use OIDC automatically.
# QUALYS_CLIENT_ID=your_client_id
# QUALYS_CLIENT_SECRET=your_client_secret

# ------ Optional overrides ------

# Qualys gateway base URL — change qg3 to match your platform region (qg1, qg2, qg3, qg4, etc.)
QUALYS_GATEWAY=https://gateway.qg3.qualys.com

# Absolute path to your existing Qualys CS script (defaults to qualys_cs_script.py in same dir)
# QUALYS_SCRIPT_PATH=/absolute/path/to/your_script.py

# Python interpreter for the subprocess call (defaults to same Python running the runner)
# QUALYS_PYTHON_BIN=/path/to/venv/bin/python
